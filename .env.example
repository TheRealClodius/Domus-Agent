# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Service auth (shared secret — must match DOMUS_SERVICE_TOKEN on Vercel)
DOMUS_SERVICE_TOKEN=

# Anthropic (Claude — agent loop)
ANTHROPIC_API_KEY=

# Google (Gemini — image generation)
GOOGLE_API_KEY=

# Perplexity (web search)
PERPLEXITY_API_KEY=

# Model selection (optional — defaults shown)
AGENT_MODEL=claude-sonnet-4-6
BUILDER_MODEL=claude-sonnet-4-6
IMAGE_GEN_MODEL=gemini-2.5-flash-image
COMPACTION_MODEL=claude-opus-4-6
